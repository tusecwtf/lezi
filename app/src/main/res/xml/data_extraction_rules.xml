<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup is already off via android:allowBackup=false.
  Device-to-device transfer must not ship family token (DataStore), Room DB,
  record photos, avatars, or widget snapshots.
  Prefer app-mediated family re-join after transfer over blind system migration.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="file" path="record-media/" />
        <exclude domain="file" path="baby_avatars/" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="lezi.db" />
        <exclude domain="database" path="lezi.db-shm" />
        <exclude domain="database" path="lezi.db-wal" />
        <exclude domain="sharedpref" path="lezi_settings.preferences_pb" />
        <exclude domain="sharedpref" path="care_widget_state_v2.xml" />
    </device-transfer>
</data-extraction-rules>
