  "dataflow_01_sleep_wake": {
    "sleep_record": {
      "mutation_keys": [
        "baby_client_uuid", "type", "custom_item_client_uuid", "timestamp", "note",
        "payload_json", "schema_version", "updated_at", "effective_wake_observation_client_uuid"
      ],
      "stable_keys": [
        "baby_client_uuid", "type", "custom_item_client_uuid", "timestamp", "note",
        "payload_json", "schema_version", "updated_at", "effective_wake_observation_client_uuid",
        "created_by_membership_id"
      ],
      "forbidden_keys": ["end_timestamp"],
      "effective_wake": "required_nullable"
    },
    "wake_observation": {
      "mutation_keys": [
        "sleep_record_client_uuid", "wake_timestamp", "note", "withdrawn", "updated_at"
      ],
      "stable_keys": [
        "sleep_record_client_uuid", "wake_timestamp", "note", "withdrawn", "updated_at",
        "observer_membership_id"
      ],
      "forbidden_keys": ["end_timestamp", "deleted", "deleted_at"]
    },
    "wake_shapes": {
      "local_mutation_keys": [
        "sleep_record_client_uuid", "wake_timestamp", "note", "withdrawn", "updated_at"
      ],
      "pull_keys": [
        "sleep_record_client_uuid", "wake_timestamp", "note", "withdrawn"
      ],
      "pull_stamp_optional": "observer_membership_id",
      "stable_root_keys": [
        "sleep_record_client_uuid", "wake_timestamp", "note", "withdrawn",
        "observer_membership_id", "updated_at"
      ]
    },
    "media_roles": [
      { "role": "wake", "owner_entity_type": "wake_observation", "kind": "wake", "owner_wire_field": "record_client_uuid", "max_items": 3 },
      { "role": "log", "owner_entity_type": "record", "kind": "log", "owner_wire_field": "record_client_uuid", "max_items": 3 },
      { "role": "plan", "owner_entity_type": "care_plan", "kind": "log", "owner_wire_field": "care_plan_client_uuid", "max_items": 3 },
      { "role": "avatar", "owner_entity_type": "baby", "kind": "avatar", "owner_wire_field": "baby_client_uuid", "max_items": 1 }
    ]
  },
  "dataflow_02_care_plan": {
    "entity_type": "care_plan",
    "mutation_keys": [
      "baby_client_uuid",
      "type",
      "custom_item_client_uuid",
      "scheduled_at",
      "scheduled_zone_id",
      "note",
      "payload_json",
      "schema_version",
      "status",
      "fulfilled_record_client_uuid",
      "fulfilled_at",
      "source_record_client_uuid",
      "updated_at"
    ],
    "stable_keys": [
      "baby_client_uuid",
      "type",
      "custom_item_client_uuid",
      "scheduled_at",
      "scheduled_zone_id",
      "note",
      "payload_json",
      "schema_version",
      "status",
      "created_by_membership_id",
      "fulfilled_record_client_uuid",
      "fulfilled_at",
      "source_record_client_uuid",
      "updated_at"
    ],
    "nullable_keys": [
      "note",
      "custom_item_client_uuid",
      "source_record_client_uuid",
      "fulfilled_record_client_uuid",
      "fulfilled_at"
    ],
    "stamp_rules": {
      "mutation_forbidden": ["created_by_membership_id"],
      "stable_required": ["created_by_membership_id"]
    },
    "fulfillment_pair": {
      "completed_requires_full_pair": true,
      "pending_requires_empty_pair": true,
      "missed_requires_empty_pair": true,
      "skipped_requires_empty_pair": true
    },
    "not_on_family_wire": [
      "system_calendar_event_id",
      "system_calendar_projection_enabled",
      "system_calendar_reminder_ready",
      "system_calendar_projection_pending",
      "sync_dirty",
      "family_published_updated_at"
    ]
  },
